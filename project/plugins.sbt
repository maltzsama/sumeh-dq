// Assembly (fat JARs)
addSbtPlugin("com.eed3si9n" % "sbt-assembly" % "2.1.5")

// Code coverage
addSbtPlugin("org.scoverage" % "sbt-scoverage" % "2.0.9")

// Formatting
addSbtPlugin("org.scalameta" % "sbt-scalafmt" % "2.5.0")

// Linting
